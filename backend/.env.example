# ==============================================================================
# HealthSync AI - Backend Environment Configuration Example
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# Core API Configuration
PROJECT_NAME="HealthSync AI"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# OCR Engine Configuration
# Windows default installation path: "C:/Program Files/Tesseract-OCR/tesseract.exe"
# Linux / macOS: "/usr/bin/tesseract" or leave blank for auto-detection in PATH
TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"

# Supabase Database, Authentication & Storage (Phase 3)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_BUCKET="medical-documents"

# Vision LLM Integration (Phase 1 Foundation & Phase 2 Extraction)
# Provider options: "gemini", "openai", "anthropic" (Leave blank if unconfigured)
LLM_PROVIDER=""
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
