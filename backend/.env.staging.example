# ==============================================================================
# HealthSync AI — Backend Staging Environment Configuration Template
# Target: Isolated Supabase Staging Project (DO NOT USE PRODUCTION CREDENTIALS)
# Instructions:
# 1. Copy this template to backend/.env.staging (or overwrite backend/.env for staging testing)
# 2. Fill in the placeholders with values from your NEW dedicated Supabase staging project.
# ==============================================================================

# Core API Configuration
PROJECT_NAME="HealthSync AI (Staging)"
VERSION="0.1.0"
ENVIRONMENT="staging"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# File Storage Configuration (Local cache/sandbox for staging)
UPLOAD_DIR="uploads_staging"
MAX_UPLOAD_SIZE_MB=10

# OCR Engine Configuration
TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"

# ------------------------------------------------------------------------------
# Dedicated Supabase Staging Project Credentials (PLACEHOLDERS ONLY)
# Create a new project in the Supabase Dashboard named "healthsync-ai-staging"
# Retrieve these values from: Settings -> API & Authentication -> JWT Settings
# ------------------------------------------------------------------------------
SUPABASE_URL="https://<staging-project-ref>.supabase.co"
SUPABASE_KEY="<staging-anon-public-jwt-token>"
SUPABASE_SERVICE_ROLE_KEY="<staging-service-role-secret-token>"
SUPABASE_JWT_SECRET="<staging-jwt-secret-key>"
SUPABASE_STORAGE_BUCKET="medical-documents"
JWT_ALGORITHM="HS256"

# ------------------------------------------------------------------------------
# Staging LLM Credentials (Optional / Mocked in testing)
# ------------------------------------------------------------------------------
LLM_PROVIDER="gemini"
LLM_API_KEY="<staging-gemini-api-key>"
LLM_MODEL="gemini-1.5-flash"
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
