# ==============================================================================
# HealthSync AI — Root .gitignore
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# Environment & Credentials (NEVER commit secrets)
.env
.env.*
.env.local
.env.*.local
*.env
*.env.local
!.env.example
!.env.*.example

# Local Uploads & Test Artifacts (Preserve directory structure via .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
scratch/

# Database files & local test outputs
*.db
*.sqlite
*.sqlite3

# Node & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDEs & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
